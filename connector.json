      "description": "List connections.",
      "method": "GET",
      "path": "/people/me/connections",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "personFields": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Value"
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "pageToken": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Value"
          }
        },
        "required": [
          "personFields"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "personFields": "personFields",
          "pageSize": "pageSize",
          "pageToken": "pageToken"
        },
        "body": {}
      },
      "sampleArguments": {
        "personFields": "names,emailAddresses",
        "pageSize": 10
      },
      "pagination": {
        "type": "cursor",
        "cursorInput": "pageToken",
        "nextCursorPath": "nextPageToken"
      },
      "provenance": [
        "https://developers.google.com/people/api/rest/v1/people.connections/list",
        "https://developers.google.com/people/api/rest/v1/people/get",
        "https://developers.google.com/people/api/rest/v1/people/createContact"
      ],
      "approvalRequired": false,
      "evidence": {
        "providerLiveValidation": "not-run",
        "localValidation": "provider-request-fixture"
      }
    },
    {
      "name": "get_contact",
      "description": "Get contact.",
      "method": "GET",
      "path": "/people/{personId}",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "personId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Suffix of a resource name: c123 from people/c123"
          },
          "personFields": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Value"
          }
        },
        "required": [
          "personId",
          "personFields"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "personId"
        ],
        "query": {
          "personFields": "personFields"
        },
        "body": {}
      },
      "sampleArguments": {
        "personId": "c123",
        "personFields": "names,emailAddresses"
      },
      "provenance": [
        "https://developers.google.com/people/api/rest/v1/people.connections/list",
        "https://developers.google.com/people/api/rest/v1/people/get",
        "https://developers.google.com/people/api/rest/v1/people/createContact"
      ],
      "approvalRequired": false,
      "evidence": {
        "providerLiveValidation": "not-run",
        "localValidation": "provider-request-fixture"
      }
    },
    {
      "name": "create_contact",
      "description": "Create contact.",
      "method": "POST",
      "path": "/people:createContact",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "personFields": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "Value"
          },
          "names": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "givenName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "description": "Value"
                },
                "familyName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "description": "Value"
                }
              },
              "required": [
                "givenName"
              ],
              "additionalProperties": false
            },
            "maxItems": 1
          },
          "emailAddresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "format": "email"
                }
              },
              "required": [
                "value"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "personFields",
          "names"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "personFields": "personFields"
        },
        "body": {
          "names": "names",
          "emailAddresses": "emailAddresses"
        }
      },
      "sampleArguments": {
        "personFields": "names,emailAddresses",
        "names": [
          {
            "givenName": "Reviewed",
            "familyName": "Contact"
          }
        ],
        "emailAddresses": [
          {
            "value": "reviewed@example.com"
          }
        ]
      },
      "provenance": [
        "https://developers.google.com/people/api/rest/v1/people.connections/list",
        "https://developers.google.com/people/api/rest/v1/people/get",
        "https://developers.google.com/people/api/rest/v1/people/createContact"
      ],
      "approvalRequired": true,
      "evidence": {
        "providerLiveValidation": "not-run",
        "localValidation": "provider-request-fixture"
      }
    }
  ],
