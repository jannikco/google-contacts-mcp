{
  "openapi": "3.1.0",
  "info": {
    "title": "Google Contacts selected operations",
    "version": "0.2.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://people.googleapis.com/v1"
    }
  ],
  "paths": {
    "/people/me/connections": {
      "get": {
        "operationId": "list_connections",
        "summary": "List connections.",
        "parameters": [
          {
            "name": "personFields",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "pageToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/people/{personId}": {
      "get": {
        "operationId": "get_contact",
        "summary": "Get contact.",
        "parameters": [
          {
            "name": "personId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Suffix of a resource name: c123 from people/c123"
            }
          },
          {
            "name": "personFields",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/people:createContact": {
      "post": {
        "operationId": "create_contact",
        "summary": "Create contact.",
        "parameters": [
          {
            "name": "personFields",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Value"
            }
          }
        ],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "names": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "givenName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "description": "Value"
                        },
                        "familyName": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2048,
                          "description": "Value"
                        }
                      },
                      "required": [
                        "givenName"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 1
                  },
                  "emailAddresses": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "format": "email"
                        }
                      },
                      "required": [
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 1000
                  }
                },
                "required": [
                  "names"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
